{
  "name": "swapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase": "npx --yes firebase-tools@latest",
    "emulators": "npx --yes firebase-tools@13 emulators:start --only auth,firestore",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "deploy:rules": "npx --yes firebase-tools@latest deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
