{
  "indexes": [
    {
      "_comment": "Board: every shift posted for the displayed month.",
      "collectionGroup": "shifts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "monthKey", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Sidebar: the signed-in intern's own shifts.",
      "collectionGroup": "shifts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Owner's inbox: who has registered interest in my shifts.",
      "collectionGroup": "interests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shiftOwnerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Cascade delete: the interests attached to one of my shifts.",
      "collectionGroup": "interests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shiftOwnerId", "order": "ASCENDING" },
        { "fieldPath": "shiftId", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Board: shifts I have already asked for, to mark them as such.",
      "collectionGroup": "interests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "takerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
