rules_version = '2';

/*
 * Swapp security rules (PDR §9.3).
 *
 * There is no backend, so this file IS the authorization layer. Everything
 * below is enforced by Firestore itself — a forged request from devtools is
 * evaluated by exactly these rules, so client-side checks in the UI are only
 * there to keep the interface honest, never to keep data safe.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return incoming().diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- users

    match /users/{userId} {
      // Owner details are denormalised onto each shift, so the board never
      // needs to read this collection — it stays private to its owner.
      allow read: if signedIn() && uid() == userId;

      allow create, update: if signedIn()
        && uid() == userId
        && incoming().displayName is string
        && incoming().displayName.size() >= 2
        && incoming().displayName.size() <= 60
        && incoming().phone is string
        && incoming().email is string;

      allow delete: if false;
    }

    // --------------------------------------------------------------- shifts

    function validShift(data) {
      return data.ownerId is string
        && data.ownerName is string
        && data.ownerPhone is string
        && data.ownerEmail is string
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string
        && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        // The month key must agree with the date, or a shift could be hidden
        // from the month it actually falls in.
        && data.monthKey == data.date[0:7]
        && data.department in ['pnimit', 'miyun_klali', 'miyun_yeladim', 'kirurgia']
        && (data.internalUnit == null || data.internalUnit is string)
        && (data.note == null || (data.note is string && data.note.size() <= 300))
        && data.urgent is bool
        && data.willingToSwap is bool
        && data.expireAt is timestamp;
    }

    match /shifts/{shiftId} {
      // Any signed-in intern can see the board (PDR §9.3).
      allow read: if signedIn();

      allow create: if signedIn()
        && incoming().ownerId == uid()
        && validShift(incoming())
        && incoming().status == 'open';

      allow update: if signedIn()
        && resource.data.ownerId == uid()
        && incoming().ownerId == uid()
        && !changedKeys().hasAny(['expireAt']);

      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // ----------------------------------------------------------- quotas

    /*
     * One doc per intern per month covers every posting limit at once (an
     * upgrade on PDR §9.3, which assumed a client-side check): `dates` is a
     * map with one key per date the intern currently holds a shift on, and
     * `urgentShiftId` is that month's one urgent shift, or null.
     *
     * "At most one shift per date": claiming an already-claimed date leaves
     * `dates` byte-identical (true -> true is not a change), so neither the
     * "claim" nor the "release" branch below is satisfied and the update is
     * denied, taking the whole batch (and the shift write) down with it.
     *
     * "At most four shifts per month, counting shifts still on the books":
     * one shift always claims exactly one date, so dates.size() *is* the
     * monthly count — no separate counter field to keep in sync.
     *
     * "One דחיפות per month": urgentShiftId may only move null -> a value
     * (claim) or a value -> null (release, on delete); a second urgent shift
     * tries value -> a different value, which neither branch allows.
     *
     * Map keys can't be regex-validated the way a plain field could (unlike
     * the old dailyLocks.date), so nothing stops a forged write claiming a
     * garbage date string as long as the size math holds — accepted, since
     * the damage is self-scoped to the caller's own doc, uid-gated like
     * everything else here.
     */
    match /quotas/{quotaId} {
      // `resource == null` matters: without it, an intern with nothing
      // posted yet this month gets permission-denied (not "not found") the
      // moment the form subscribes to pre-check against this doc. Not a new
      // leak — /shifts is already world-readable to any signed-in intern.
      allow read: if signedIn() && (resource == null || resource.data.uid == uid());

      allow create: if signedIn()
        && quotaId == uid() + '__' + incoming().monthKey
        && incoming().uid == uid()
        && incoming().monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && incoming().dates.size() == 1
        && (incoming().get('urgentShiftId', null) == null
            || incoming().get('urgentShiftId', null) is string)
        && incoming().expireAt is timestamp;

      allow update: if signedIn()
        && resource.data.uid == uid()
        && changedKeys().hasOnly(['dates', 'urgentShiftId'])
        && (
          ( // claiming a new date
            incoming().dates.diff(resource.data.dates).addedKeys().size() == 1
            && incoming().dates.diff(resource.data.dates).removedKeys().size() == 0
            && incoming().dates.size() <= 4
            && (
              incoming().get('urgentShiftId', null) == resource.data.get('urgentShiftId', null)
              || (resource.data.get('urgentShiftId', null) == null
                  && incoming().get('urgentShiftId', null) is string)
            )
          )
          ||
          ( // releasing a date
            incoming().dates.diff(resource.data.dates).removedKeys().size() == 1
            && incoming().dates.diff(resource.data.dates).addedKeys().size() == 0
            && (
              incoming().get('urgentShiftId', null) == resource.data.get('urgentShiftId', null)
              || (incoming().get('urgentShiftId', null) == null
                  && resource.data.get('urgentShiftId', null) is string)
            )
          )
        );

      allow delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
